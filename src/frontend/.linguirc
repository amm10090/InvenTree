{
    "locales": [
        "en",
        "zh_Hans"
    ],
    "catalogs": [{
        "path": "src/locales/{locale}/messages",
        "include": ["src", "lib"],
        "exclude": ["**/node_modules/**", "./dist/**"]
    }],
    "format": "po",
    "orderBy": "origin",
    "sourceLocale": "en",
    "fallbackLocales": {
        "default": "en"
    }
}
